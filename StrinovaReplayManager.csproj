<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>StrinovaReplayManager</RootNamespace>
    <AssemblyTitle>Strinova Replay Manager</AssemblyTitle>
    <Product>Strinova Replay Manager</Product>
    <FileDescription>Strinova Replay Manager</FileDescription>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="'$(PublishProfile)' == '' And '$(RuntimeIdentifier)' != '' And Exists('Properties\PublishProfiles\$(RuntimeIdentifier).pubxml')">$(RuntimeIdentifier).pubxml</PublishProfile>
    <PublishProfile Condition="'$(PublishProfile)' == '' And Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Assets\GenerateIcons.cs" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- WinUI/XAML binding and WinRT metadata break under IL trimming in published builds. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- dotnet publish omits compiled XAML (.xbf), MRT (.pri), and content assets unless copied explicitly. -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIPublishXbf Include="$(OutputPath)*.xbf" />
      <_WinUIPublishStylesXbf Include="$(OutputPath)Styles\*.xbf" />
      <_WinUIPublishPri Include="$(OutputPath)$(AssemblyName).pri" />
      <_WinUIPublishAssets Include="$(OutputPath)Assets\*.*" Exclude="$(OutputPath)Assets\GenerateIcons.cs;$(OutputPath)Assets\SRM.png" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIPublishXbf)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPublishStylesXbf)" DestinationFolder="$(PublishDir)Styles" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPublishPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPublishAssets)" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
